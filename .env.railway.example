# Railway variables template (committed). Copy the values into the Railway dashboard, or
# push them via the CLI (secrets piped from their source files, never echoed):
#
#   railway variables --service web    --skip-deploys --set-from-stdin RAILS_MASTER_KEY < config/master.key
#   railway variables --service web    --skip-deploys --set-from-stdin GCS_KEYFILE_JSON < ~/.config/gcloud-keys/<key>.json
#   railway variables --service web    --skip-deploys --set 'DATABASE_URL=${{Postgres.DATABASE_URL}}' --set 'REDIS_URL=${{Redis.REDIS_URL}}' --set GCS_PROJECT=... --set GCS_BUCKET=... --set SIDEKIQ_USER=admin
#   (repeat for --service worker, plus --set PROCESS_TYPE=worker)
#
# Set on BOTH the `web` and `worker` services unless noted.

# --- shared (web + worker) ---
RAILS_MASTER_KEY=<contents of config/master.key>
DATABASE_URL=${{Postgres.DATABASE_URL}}      # Railway reference to the Postgres service
REDIS_URL=${{Redis.REDIS_URL}}               # Railway reference to the Redis service
GCS_PROJECT=<your-gcp-project>
GCS_BUCKET=<your-gcs-bucket>
GCS_KEYFILE_JSON=<service-account key JSON, single line>

# --- web only (gates the /sidekiq dashboard) ---
SIDEKIQ_USER=admin
SIDEKIQ_PASSWORD=<choose a strong value>

# --- worker only (selects the Sidekiq role in bin/boot) ---
PROCESS_TYPE=worker

# Redis service: Redis defaults to maxmemory-policy=noeviction (required by Sidekiq);
# only revisit if you set a maxmemory with an eviction policy.
