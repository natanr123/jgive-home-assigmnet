<!DOCTYPE html>
<html dir="rtl" lang="he">
  <head>
    <title><%= content_for(:title) || "הגן הכתום — גיוס תרומות אונליין | Jgive" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="הצטרפו והיו ממקימי ׳הגן הכתום׳ — לזכר בני משפחת ביבס וילדי ה-7 באוקטובר.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%# Google Fonts: Heebo — closest free Hebrew sans to JGive's proprietary "Simona" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;900&display=swap">

    <%# esbuild-emitted bundle (JS + the CSS-modules output) %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", type: "module", defer: true %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
